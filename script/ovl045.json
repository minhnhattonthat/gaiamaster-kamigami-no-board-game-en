 "strings": [
  {
   "id": "ovl045_800C8454",
   "at": "800C8454",
   "jp": "ガイアマスターの勝者よ",
   "en": "Victor of GaiaMaster,",
   "max": 23,
   "refs": [
    "lui@2E0/2E4"
   ],
   "notes": ""
  },
  {
   "id": "ovl045_800C846C",
   "at": "800C846C",
   "jp": "定めどおり、望みをかなえよう",
   "en": "as decreed, I shall grant your wish.",
   "max": 31,
   "refs": [
    "lui@2EC/2F0"
   ],
   "notes": ""
  },
  {
   "id": "ovl045_800C848C",
   "at": "800C848C",
   "jp": "なにを望む？金か？力か？",
   "en": "What do you desire? Gold? Power?",
   "max": 27,
   "refs": [
    "lui@2F8/2FC"
   ],
   "notes": ""
  },
  {
   "id": "ovl045_800C84A8",
   "at": "800C84A8",
   "jp": "ただ平和を",
   "en": "Only peace.",
   "max": 11,
   "refs": [
    "lui@330/334"
   ],
   "notes": ""
  },
  {
   "id": "ovl045_800C84B8",
   "at": "800C84B8",
   "jp": "ええっ！？",
   "en": "Whaaat!?",
   "max": 11,
   "refs": [
    "lui@378/37C"
   ],
   "notes": ""
  },
  {
   "id": "ovl045_800C84C4",
   "at": "800C84C4",
   "jp": "なにもほしくないの！？",
   "en": "You don't want anything!?",
   "max": 23,
   "refs": [
    "lui@384/388"
   ],
   "notes": ""
  },
  {
   "id": "ovl045_800C84DC",
   "at": "800C84DC",
   "jp": "せっかく優勝したのに！！",
   "en": "And after all that, you won!!",
   "max": 27,
   "refs": [
    "lui@390/394"
   ],
   "notes": ""
  },
  {
   "id": "ovl045_800C84F8",
   "at": "800C84F8",
   "jp": "ガイアマスターを終わらせてほしい",
   "en": "Bring GaiaMaster to an end.",
   "max": 35,
   "refs": [
    "lui@3C8/3CC"
   ],
   "notes": ""
  },
  {
   "id": "ovl045_800C851C",
   "at": "800C851C",
   "jp": "このようなゲームで下界にわざわいを",
   "en": "Let no game like this ever again",
   "max": 35,
   "refs": [
    "lui@3D4/3D8"
   ],
   "notes": ""
  },
  {
   "id": "ovl045_800C8540",
   "at": "800C8540",
   "jp": "もたらすのは、これでさいごに",
   "en": "bring calamity to the world below.",
   "max": 31,
   "refs": [
    "lui@3E0/3E4"
   ],
   "notes": ""
  },
  {
   "id": "ovl045_800C8560",
   "at": "800C8560",
   "jp": "なんじの望みをかなえよう",
