 "kind": "fields",
 "strings": [
  {
   "id": "endings09_0000",
   "at": "0000",
   "jp": "その名声は世界中にとどろき、",
   "en": "His fame rang across the world,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_0023",
   "at": "0023",
   "jp": "侍の中の侍として",
   "en": "and as the samurai of samurai,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_0046",
   "at": "0046",
   "jp": "その名はれきしにきざまれました。",
   "en": "his name was carved into history.",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_0069",
   "at": "0069",
   "jp": "てがらをたたえられて",
   "en": "Praised for his great deeds,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_008C",
   "at": "008C",
   "jp": "領地をあたえられ、",
   "en": "he was granted a fief,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_00AF",
   "at": "00AF",
   "jp": "じゅんちょうな人生をおくりました。",
   "en": "and his life went without a hitch.",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_00D2",
   "at": "00D2",
   "jp": "トリもかよわぬさいはての地に",
   "en": "To the ends of the earth, where",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_00F5",
   "at": "00F5",
   "jp": "追いやられ、",
   "en": "not even birds fly, he was exiled,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_0118",
   "at": "0118",
   "jp": "なげきながら一生をおくりました。",
   "en": "and lived out his days lamenting.",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_013B",
   "at": "013B",
   "jp": "腹を切ることもゆるされず、",
   "en": "Not even permitted seppuku,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_015E",
   "at": "015E",
   "jp": "生きハジをさらしながら、",
   "en": "he lived on in shame,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings09_0181",
   "at": "0181",
   "jp": "ミジメにくらしていきました。",
   "en": "a wretched existence.",
   "max": 34,
   "refs": [],
   "notes": ""
  }
 ]
}
