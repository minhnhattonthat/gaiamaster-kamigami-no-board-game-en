 "strings": [
  {
   "id": "endings06_0000",
   "at": "0000",
   "jp": "世界中の人々にしたわれて、",
   "en": "Adored by people the world over,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings06_0023",
   "at": "0023",
   "jp": "全世界をおさめる女王となりました。",
   "en": "she became queen of all the world.",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings06_0069",
   "at": "0069",
   "jp": "王女として、そこそこイケてる人生を",
   "en": "As a princess, she led a life",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings06_008C",
   "at": "008C",
   "jp": "おくりました。",
   "en": "that was pretty decent.",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings06_00D2",
   "at": "00D2",
   "jp": "好きでもないおとこと",
   "en": "To a man she didn't even like,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings06_00F5",
   "at": "00F5",
   "jp": "せいりゃくケッコンさせられて、",
   "en": "she was married off for politics,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings06_0118",
   "at": "0118",
   "jp": "ずっとなきながらくらしました。",
   "en": "and spent her whole life in tears.",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings06_013B",
   "at": "013B",
   "jp": "国の金を使いこんで、",
   "en": "She squandered the royal treasury,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings06_015E",
   "at": "015E",
   "jp": "飢えた民衆にかくめいをおこされ、",
   "en": "the starving people revolted,",
   "max": 34,
   "refs": [],
   "notes": ""
  },
  {
   "id": "endings06_0181",
   "at": "0181",
   "jp": "国を追われました。",
   "en": "and she was driven from her land.",
   "max": 34,
   "refs": [],
   "notes": ""
  }
 ]
}
